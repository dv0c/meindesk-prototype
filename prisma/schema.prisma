// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  username          String?
  image             String?
  email             String         @unique
  emailVerified     DateTime?
  hashedPassword    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  role              Role           @default(USER)
  sessions          Session[]
  accounts          Account[]
  Site              Site[]
  Category          Category[]
  Subscription      Subscription[]
  Article           Article[]
  Page              Page[]
  Notification      Notification[] // Received
  sentNotifications Notification[] @relation("Sender") // Sent

  developerMode Boolean @default(false)

  @@index([email, id])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name        String
  description String
  slug        String

  thumbnail String? // Single thumbnail URL instead of imageUrls array
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  siteId String? @db.ObjectId

  metadata Json?
  user     User?   @relation(fields: [userId], references: [id])
  userId   String? @db.ObjectId
  rsses    Rss[]
}

model Site {
  // Primary Key and ID (Standard MongoDB/Prisma Setup)
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // --- Tenant Identity and Limits ---
  // Subdomain is the key identifier for middleware lookup. 
  // It's indexed and unique for fast lookups.
  subdomain String @unique
  url       String @unique // Full domain/URL (e.g., 'sub.yourdomain.com')

  // Usage/Quota Management
  views      Int @default(0) // Current views count
  limitViews Int @default(5000) // The subscription or plan view limit

  // --- Content and Branding ---
  title                  String
  description            String?
  logo                   String? // URL or reference to the logo image
  theme                  Json?    @default("{\"light\":{\"background\":\"oklch(1 0 0)\",\"foreground\":\"oklch(0.145 0 0)\",\"card\":\"oklch(1 0 0)\",\"card_foreground\":\"oklch(0.145 0 0)\",\"popover\":\"oklch(1 0 0)\",\"popover_foreground\":\"oklch(0.145 0 0)\",\"primary\":\"oklch(0.205 0 0)\",\"primary_foreground\":\"oklch(0.985 0 0)\",\"secondary\":\"oklch(0.97 0 0)\",\"secondary_foreground\":\"oklch(0.205 0 0)\",\"muted\":\"oklch(0.97 0 0)\",\"muted_foreground\":\"oklch(0.556 0 0)\",\"accent\":\"oklch(0.97 0 0)\",\"accent_foreground\":\"oklch(0.205 0 0)\",\"destructive\":\"oklch(0.577 0.245 27.325)\",\"destructive_foreground\":\"oklch(1 0 0)\",\"border\":\"oklch(0.922 0 0)\",\"input\":\"oklch(0.922 0 0)\",\"ring\":\"oklch(0.708 0 0)\",\"chart_1\":\"oklch(0.81 0.1 252)\",\"chart_2\":\"oklch(0.62 0.19 260)\",\"chart_3\":\"oklch(0.55 0.22 263)\",\"chart_4\":\"oklch(0.49 0.22 264)\",\"chart_5\":\"oklch(0.42 0.18 266)\",\"sidebar\":\"oklch(0.985 0 0)\",\"sidebar_foreground\":\"oklch(0.145 0 0)\",\"sidebar_primary\":\"oklch(0.205 0 0)\",\"sidebar_primary_foreground\":\"oklch(0.985 0 0)\",\"sidebar_accent\":\"oklch(0.97 0 0)\",\"sidebar_accent_foreground\":\"oklch(0.205 0 0)\",\"sidebar_border\":\"oklch(0.922 0 0)\",\"sidebar_ring\":\"oklch(0.708 0 0)\",\"font_sans\":\"ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \\\"Segoe UI\\\", Roboto, \\\"Helvetica Neue\\\", Arial, \\\"Noto Sans\\\", sans-serif, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"\",\"font_serif\":\"ui-serif, Georgia, Cambria, \\\"Times New Roman\\\", Times, serif\",\"font_mono\":\"ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \\\"Liberation Mono\\\", \\\"Courier New\\\", monospace\",\"radius\":\"0rem\",\"shadow_x\":\"0\",\"shadow_y\":\"1px\",\"shadow_blur\":\"3px\",\"shadow_spread\":\"0px\",\"shadow_opacity\":\"0.1\",\"shadow_color\":\"oklch(0 0 0)\",\"shadow_2xs\":\"0 1px 3px 0px hsl(0 0% 0% / 0.05)\",\"shadow_xs\":\"0 1px 3px 0px hsl(0 0% 0% / 0.05)\",\"shadow_sm\":\"0 1px 3px 0px hsl(0 0% 0% / 0.1), 0 1px 2px -1px hsl(0 0% 0% / 0.1)\",\"shadow\":\"0 1px 3px 0px hsl(0 0% 0% / 0.1), 0 1px 2px -1px hsl(0 0% 0% / 0.1)\",\"shadow_md\":\"0 1px 3px 0px hsl(0 0% 0% / 0.1), 0 2px 4px -1px hsl(0 0% 0% / 0.1)\",\"shadow_lg\":\"0 1px 3px 0px hsl(0 0% 0% / 0.1), 0 4px 6px -1px hsl(0 0% 0% / 0.1)\",\"shadow_xl\":\"0 1px 3px 0px hsl(0 0% 0% / 0.1), 0 8px 10px -1px hsl(0 0% 0% / 0.1)\",\"shadow_2xl\":\"0 1px 3px 0px hsl(0 0% 0% / 0.25)\",\"tracking_normal\":\"0em\",\"spacing\":\"0.25rem\"},\"dark\":{\"background\":\"oklch(0.145 0 0)\",\"foreground\":\"oklch(0.985 0 0)\",\"card\":\"oklch(0.205 0 0)\",\"card_foreground\":\"oklch(0.985 0 0)\",\"popover\":\"oklch(0.269 0 0)\",\"popover_foreground\":\"oklch(0.985 0 0)\",\"primary\":\"oklch(0.922 0 0)\",\"primary_foreground\":\"oklch(0.205 0 0)\",\"secondary\":\"oklch(0.269 0 0)\",\"secondary_foreground\":\"oklch(0.985 0 0)\",\"muted\":\"oklch(0.269 0 0)\",\"muted_foreground\":\"oklch(0.708 0 0)\",\"accent\":\"oklch(0.371 0 0)\",\"accent_foreground\":\"oklch(0.985 0 0)\",\"destructive\":\"oklch(0.704 0.191 22.216)\",\"destructive_foreground\":\"oklch(0.985 0 0)\",\"border\":\"oklch(0.275 0 0)\",\"input\":\"oklch(0.325 0 0)\",\"ring\":\"oklch(0.556 0 0)\",\"chart_1\":\"oklch(0.81 0.1 252)\",\"chart_2\":\"oklch(0.62 0.19 260)\",\"chart_3\":\"oklch(0.55 0.22 263)\",\"chart_4\":\"oklch(0.49 0.22 264)\",\"chart_5\":\"oklch(0.42 0.18 266)\",\"sidebar\":\"oklch(0.205 0 0)\",\"sidebar_foreground\":\"oklch(0.985 0 0)\",\"sidebar_primary\":\"oklch(0.488 0.243 264.376)\",\"sidebar_primary_foreground\":\"oklch(0.985 0 0)\",\"sidebar_accent\":\"oklch(0.269 0 0)\",\"sidebar_accent_foreground\":\"oklch(0.985 0 0)\",\"sidebar_border\":\"oklch(0.275 0 0)\",\"sidebar_ring\":\"oklch(0.439 0 0)\"}}")
  status                 String   @default("active") // New: 'active', 'suspended', 'trial', 'pending'
  defaultThemePreference String   @default("system")
  template_schema        Json?    @default("{\"version\": \"1.2.0\",\"template\": \"simple\", \"global\": {\"container\": \"max-w-7xl\"}}")
  settings               Json?    @default("{}") // Global website settings (fonts, colors, SEO, etc.)
  // --- Timestamps ---
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Main Pages
  home_Id           String?
  privacy_policy_id String?
  cookies_id        String?
  terms_id          String?

  // --- Relationships (Foreign Keys) ---
  // User (Owner)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade) // Changed to User? if Site can exist before owner is assigned
  userId String? @db.ObjectId // Changed to String? if Site can exist before owner is assigned

  // Features/Plan (The tenant's feature package)
  features   Features? @relation(fields: [featuresId], references: [id])
  featuresId String?   @db.ObjectId

  // Subscription Details (Billing context)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?       @db.ObjectId

  // --- Embedded/Referenced Content ---
  category            Category[]
  Article             Article[]
  Page                Page[]
  RSS                 Rss[]
  AnalyticsEvent      AnalyticsEvent[]
  installedThemes     SiteTheme[]
  snippets            Snippet[]
  customFeedTemplates CustomFeedTemplate[]
  mergedFeeds         MergedFeed[]
  Notification        Notification[]
  collections         Collection[]

  // Optional: Add a custom index for performance on frequently queried fields
  @@index([userId])
  @@map("sites") // Optional: Custom collection name
}

// --- Snippets Model ---
// User-created reusable component snippets
model Snippet {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  category    String   @default("custom") // e.g., "header", "footer", "section", "custom"
  thumbnail   String? // Optional preview image
  content     Json // LayoutNode[] - the actual component tree
  siteId      String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Features {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  analytics  Boolean @default(true)
  articles   Boolean @default(true)
  pages      Boolean @default(true)
  categories Boolean @default(true)
  media      Boolean @default(true)
  rss        Boolean @default(true)

  viewslimit Int @default(500)
  ratelimit  Int @default(10000)

  Site Site[]
}

model Subscription {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  price             Float
  billing_cycle     String
  status            String   @default("active")
  plan              String   @default("Basic")
  next_billing_date DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  Site           Site[]
  BillingHistory BillingHistory[]
}

model BillingHistory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String   @db.ObjectId
  amount         Float
  currency       String   @default("EUR")
  status         String // "paid", "pending", "failed"
  date           DateTime @default(now())
  invoiceUrl     String?
  description    String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  siteId    String   @db.ObjectId
  path      String
  referrer  String?
  userAgent String?
  region    String?
  device    String?
  ipAddress String?
  createdAt DateTime @default(now())

  Site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model Article {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  siteId String @db.ObjectId

  title String
  slug  String @default(uuid())

  excerpt String?
  content Json?
  html    String?

  cover String?

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  status ArticleStatus @default(DRAFT)

  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  categories String[]

  sourceType ArticleSourceType @default(MANUAL)
  sourceId   String? // if RSS, store RssItem.id

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String @db.ObjectId

  metadata Json?

  @@unique([slug, siteId])
  @@index([slug, id])
}

enum ArticleStatus {
  PUBLISHED
  DRAFT
  BANNED
  DELETED
}

model Page {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String     @default(uuid())
  excerpt   String?
  order     Int?
  layout    Json[]
  status    PageStatus @default(DRAFT)
  parentId  String?    @db.ObjectId
  authorId  String?    @db.ObjectId
  meta      Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  siteId    String     @db.ObjectId
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId    String?    @db.ObjectId
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locked    Boolean    @default(false)

  // virtual relations (manual linking)
  // These aren't real foreign keys, just convenience for TypeScript typing
  // You’ll manually query related pages/users using the IDs
  @@unique([slug, siteId])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleSourceType {
  MANUAL
  RSS
  API
}

model Rss {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  icon        String?
  url         String?
  siteId      String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  autoImport  Boolean  @default(false)

  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rssItems   RssItem[]
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?   @db.ObjectId
}

model RssItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  rssId       String    @db.ObjectId
  title       String
  site_name   String
  link        String
  description String?
  thumbnail   String?
  publishedAt DateTime?
  content     String?
  author      String?
  categories  String[]
  guid        String? // unique ID from feed, helps deduplication
  createdAt   DateTime  @default(now())

  rss Rss @relation(fields: [rssId], references: [id], onDelete: Cascade)
}

// --- Custom Feed Template for Visual RSS Builder ---
// Stores user-defined CSS selectors for scraping any website

model CustomFeedTemplate {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  siteId String @db.ObjectId

  name      String
  targetUrl String // Base URL to scrape (e.g., "https://example.com/blog")

  // CSS Selectors for scraping
  containerSelector   String // Selector for each article container
  titleSelector       String? // Selector for title (relative to container)
  linkSelector        String? // Selector for link (relative to container)
  thumbnailSelector   String? // Selector for thumbnail image
  descriptionSelector String? // Selector for description/excerpt
  dateSelector        String? // Selector for publish date
  authorSelector      String? // Selector for author name

  // Scraping options
  linkAttribute      String @default("href") // Attribute to extract from linkSelector
  thumbnailAttribute String @default("src") // Attribute to extract from thumbnailSelector
  maxItems           Int    @default(20) // Max items to scrape per run

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// --- Merged Feed for RSS Aggregator ---
// Combines multiple RSS feeds with filters

model MergedFeed {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  siteId String @db.ObjectId

  name        String
  description String?

  // Source feeds: Array of { type: "url" | "template", value: string }
  sources Json

  // Filter rules: { include: string[], exclude: string[] }
  filters Json?

  maxItems Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// --- Theme Store Models ---

model Theme {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  thumbnail   String?
  price       Float   @default(0)
  isPremium   Boolean @default(false)

  // Font configuration: array of { family, type, weights, subsets, url, variable }
  fonts Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks      ThemeBlock[]
  installedIn SiteTheme[]
}

model ThemeBlock {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  themeId String @db.ObjectId

  // The internal component name (e.g. "Navbar", "Hero", "SpecialFeature")
  componentName String

  // Metadata for the builder to recognize it (props, category, etc.)
  // This allows us to dynamically register it in the builder
  componentDefinition Json

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)
}

model SiteTheme {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  siteId      String   @db.ObjectId
  themeId     String   @db.ObjectId
  installedAt DateTime @default(now())

  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([siteId, themeId])
}

model Notification {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String  @db.ObjectId
  siteId String? @db.ObjectId

  title    String
  message  String
  link     String?
  imageUrl String?

  type NotificationType @default(INFO)
  read Boolean          @default(false)

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site? @relation(fields: [siteId], references: [id])

  sender   User?   @relation("Sender", fields: [senderId], references: [id])
  senderId String? @db.ObjectId
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  PROMO
  SYSTEM
}

// --- Dynamic Content System ---

model Collection {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  siteId      String  @db.ObjectId
  name        String
  slug        String
  description String?

  // Field Definitions: Array of { name: string, type: "text" | "number" | "image" | "boolean" | "date" | "richtext", label: string, required: boolean }
  fields Json

  items CollectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
}

model CollectionItem {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  collectionId String @db.ObjectId

  // Dynamic Data: Key-Value pairs matching the Collection fields
  data Json

  slug   String // For public routing
  status ItemStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, slug])
}

enum ItemStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}
